types SlavesPositions{
	type vbox_slave_positions_tiers = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 5
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 15 15
			}
			margin_bottom = 10
			spacing = 10
			expand = {
			}
			expand = {
			}
		}
		### Slave Position Group Foldouts ###
		scrollbox = {
			using = Animation_Tab_Switch
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_margins"
			{
				margin = { 6 10
				}
				margin_right = 20
			}
			blockoverride scrollbox_content {
				layoutpolicy_horizontal = expanding
				flowcontainer = {
					name = "verticalrows"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					direction = vertical
					spacing = 40
					flowcontainer = {
						name = "First Row"
						direction = horizontal
						min_width = 1280
						max_width = 1280
						min_height = 600
						spacing = 30
						flowcontainer = {
							name = "greatwife"
							direction = vertical
							min_width = 450
							min_height = 380
							flowcontainer = {
								name = "header"
								direction = horizontal
								min_width = 430
								min_height = 30
								background = {
									using = Background_Area_Solid
								}
							}
							scrollarea = {
								minimumsize = {430 600
								}
								background = {
									using = Background_Bottom_Fade
								}
								scrollwidget = {
									flowcontainer = {
										direction = horizontal
										layoutpolicy_horizontal = expanding
										min_height = 380
										dynamicgridbox = {
											datamodel = "[GetPlayer.MakeScope.GetList('great_slaves')]"
											flipdirection = yes
											item = {
												flowcontainer = {
													name = "big flow"
													min_height = 335
													allow_outside = no
													margin = { 8 10
													}
													direction = horizontal
													datacontext = "[Scope.GetCharacter]"
													flowcontainer = {
														direction = vertical
														flowcontainer = {
															resizeparent = no
															parentanchor = top|hcenter
															text_single = {
																text = "status_tier: [Character.MakeScope.Var('status_tier').GetValue]"
																align = center
																fontsize = 21
																max_width = 170
																min_width = 170
															}
															background = {
																using=Background_Area_ExtraDark
																margin_top = 10
																margin_left = 20
																margin_right = 20
																margin_bottom = 20
															}
														}
														portrait_body_large= {
														}
														background = {
															using = Background_Area
															margin_bottom = 20
														}
													}
												}
											}
										}
									}
								}
								scrollbar_horizontal = {
									using = Scrollbar_Horizontal
								}
								scrollbarpolicy_horizontal = always_on
								scrollbarpolicy_vertical = always_off
								scrollbaralign_horizontal = bottom
							}
						}
						flowcontainer = {
							name = "secwife"
