types SlavesPositions{
	type slave_tier_section = flowcontainer {
		direction = vertical
		block "slave_tier_size" {
			min_width = 1250
			min_height = 380
		}
		flowcontainer = {
			name = "header"
			direction = horizontal
			min_height = 30
			block "slave_tier_header_width" {
				min_width = 1250
			}
			background = {
				using = Background_Area_Solid
			}
		}
		scrollarea = {
			block "slave_tier_scroll_size" {
				minimumsize = { 1250 600
				}
			}
			background = {
				using = Background_Bottom_Fade
			}
			scrollwidget = {
				flowcontainer = {
					direction = horizontal
					layoutpolicy_horizontal = expanding
					min_height = 380
					dynamicgridbox = {
						block "slave_tier_datamodel" {
						}
						flipdirection = yes
						item = {
							flowcontainer = {
								name = "big flow"
								min_height = 335
								allow_outside = no
								margin = { 0 10
								}
								direction = horizontal
								datacontext = "[Scope.GetCharacter]"
								flowcontainer = {
									direction = vertical
									flowcontainer = {
										resizeparent = no
										parentanchor = top|hcenter
										direction = vertical
										spacing = 10
										min_width = 330
										text_single = {
											parentanchor = top|hcenter
											text = "[Character.GetNameNoTooltip] [Character.GetAge] ([Character.MakeScope.Var('status_tier').GetValue])"
											align = center
											fontsize = 21
											max_width = 330
											min_width = 330
										}
										flowcontainer = {
											parentanchor = top|hcenter
											direction = horizontal
											spacing = 10
											button_standard = {
												size = { 44 44
												}
												icon = {
													texture = "gfx/interface/icons/icon_trend_arrow.dds"
													framesize = { 22 22
													}
													size = { 100% 100%
													}
												}
												onclick = "[GetScriptedGui('slave_mgmt_promote').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'slave', Character.MakeScope ).End )]"
											}
											button_standard = {
												size = { 44 44
												}
												icon = {
													texture = "gfx/interface/icons/icon_trend_arrow.dds"
													framesize = { 22 22
													}
													frame = 2
													size = { 100% 100%
													}
												}
												onclick = "[GetScriptedGui('slave_mgmt_demote').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'slave', Character.MakeScope ).End )]"
											}
											button_standard = {
												size = { 44 44
												}
												icon_flat_standard_gold = {
													size = { 100% 100%
													}
													texture = "gfx/interface/icons/flat_icons/plus.dds"
												}
											}
											button_standard = {
												size = { 44 44
												}
												icon_flat_standard_red = {
													size = { 100% 100%
													}
													texture = "gfx/interface/icons/flat_icons/cancel.dds"
												}
											}
										}
										background = {
											using = Background_Area_ExtraDark
											margin_top = 10
											margin_left = 20
											margin_right = 20
											margin_bottom = 20
										}
									}
									portrait_body_large = {
									}
									background = {
										using = Background_Area
										margin_bottom = 20
									}
								}
							}
						}
					}
				}
			}
			scrollbar_horizontal = {
				using = Scrollbar_Horizontal
			}
			scrollbarpolicy_horizontal = always_on
			scrollbarpolicy_vertical = always_off
			scrollbaralign_horizontal = bottom
		}
	}
	type vbox_slave_positions_tiers = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 5
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 15 15
			}
			margin_bottom = 10
			spacing = 10
			expand = {
			}
			expand = {
			}
		}
		### Slave Position Group Foldouts ###
		scrollbox = {
			using = Animation_Tab_Switch
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_margins"
			{
				margin = { 6 10
				}
				margin_right = 20
			}
			blockoverride scrollbox_content {
				layoutpolicy_horizontal = expanding
				flowcontainer = {
					name = "verticalrows"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					direction = vertical
					spacing = 40
					### First Row: Great Wives + Secondary Wives side by side ###
					flowcontainer = {
						name = "First Row"
						direction = horizontal
						min_width = 1280
						max_width = 1280
						min_height = 600
						spacing = 30
						slave_tier_section = {
							name = "greatwife"
							blockoverride "slave_tier_size" {
								min_width = 450
								min_height = 380
							}
							blockoverride "slave_tier_header_width" {
								min_width = 430
							}
							blockoverride "slave_tier_scroll_size" {
								minimumsize = { 430 600
								}
							}
							blockoverride "slave_tier_datamodel" {
								datamodel = "[GetPlayer.MakeScope.GetList('great_slaves')]"
							}
						}
						slave_tier_section = {
							name = "secwife"
							blockoverride "slave_tier_size" {
								min_width = 770
								min_height = 380
							}
							blockoverride "slave_tier_header_width" {
								min_width = 770
							}
							blockoverride "slave_tier_scroll_size" {
								minimumsize = { 770 600
								}
							}
							blockoverride "slave_tier_datamodel" {
								datamodel = "[GetPlayer.MakeScope.GetList('secondary_slaves')]"
							}
						}
					}
					### Second Row: Concubine Slaves ###
					slave_tier_section = {
						name = "Second Row"
						blockoverride "slave_tier_datamodel" {
							datamodel = "[GetPlayer.MakeScope.GetList('concubine_slaves')]"
						}
					}
					### Third Row: Decorative Slaves ###
					slave_tier_section = {
						name = "Third Row"
						blockoverride "slave_tier_scroll_size" {
							minimumsize = { 1250 700
							}
						}
						blockoverride "slave_tier_datamodel" {
							datamodel = "[GetPlayer.MakeScope.GetList('decorative_slaves')]"
						}
					}
				}
			}
		}
		expand = {
		}
	}
}
