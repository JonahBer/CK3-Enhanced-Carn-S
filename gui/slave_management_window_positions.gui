types SlavesPositions{
	type vbox_slave_positions = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 5
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 15 15
			}
			margin_bottom = 10
			spacing = 10
			expand = {
			}
			expand = {
			}
		}
		### Slave Position Group Foldouts ###
		scrollbox = {
			using = Animation_Tab_Switch
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_margins"
			{
				margin = { 6 10
				}
				margin_right = 20
			}
			blockoverride scrollbox_content {
				layoutpolicy_horizontal = expanding
				dynamicgridbox = {
					datamodel = "[GetPlayer.MakeScope.GetList('decorative_slaves')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					#flipdirection = yes
					maxhorizontalslots = 1
					item = {
						flowcontainer = {
							name = "big flow"
							parentanchor = hcenter
							max_width = 500
							max_height = 340
							min_width = 340
							min_height = 340
							allow_outside = no
							margin = { 8 10
							}
							direction = horizontal
							datacontext = "[Scope.GetCharacter]"
							flowcontainer = {
								direction = vertical
								flowcontainer = {
									resizeparent = no
									parentanchor = top|hcenter
									text_single = {
										text = "[Character.GetFullNameNoTooltip]"
										align = center
										fontsize = 21
										max_width = 170
										min_width = 170
									}
									background = {
										using=Background_Area_ExtraDark
										margin_top = 10
										margin_left = 20
										margin_right = 20
										margin_bottom = 20
									}
								}
								portrait_body= {
								}
								background = {
									using = Background_Area
									margin_bottom = 20
								}
							}
							flowcontainer = {
								name = "stat flow"
								min_width = 221
								min_height = 320
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								scrollarea = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									scrollwidget = {
										min_width = 120
										max_width = 120
										max_height = 340
										min_height = 340
										flowcontainer = {
											direction = vertical
											resizeparent = yes
											text_single = {
												text = "hi"
												align = left
												autoresize = yes
											}
											text_single = {
												text = "[Character.GetFullNameNoTooltip]"
												align = center
												autoresize = yes
											}
											text_single = {
												text = "[Character.GetFullNameNoTooltip]"
												align = center
												autoresize = yes
											}
											text_single = {
												text = "[Character.GetFullNameNicknamed]"
												align = center
												autoresize = yes
											}
										}
									}
									scrollbarpolicy_horizontal = always_off
									scrollbar_vertical = {
										using = editor_vertical_scrollbar
									}
								}
								background = {
									using = Background_Area
									margin_top = 10
									margin_bottom = 10
								}
							}
						}
					}
				}
			}
		}
		expand = {
		}
	}
